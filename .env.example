# Configure one AI provider. OpenAI is preferred when both are present.
OPENAI_API_KEY=
OPENAI_ASR_MODEL=gpt-4o-mini-transcribe
OPENAI_FAST_TEXT_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy
OPENAI_TTS_SPEED=0.9

# Cloudflare Workers AI fallback/provider.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_WORKERS_AI_API_TOKEN=
CLOUDFLARE_ASR_MODEL=@cf/openai/whisper-large-v3-turbo
CLOUDFLARE_TEXT_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
CLOUDFLARE_TTS_MODEL=@cf/deepgram/aura-1
CLOUDFLARE_TTS_SPEAKER=luna

# Local storage is the default development mode.
PERSISTENCE_BACKEND=local
AUDIO_STORAGE_BACKEND=local

# Required in production for the admin API and scheduled cleanup endpoint.
ADMIN_API_TOKEN=
CRON_SECRET=

# Managed storage (only needed when the corresponding backend is selected).
DATABASE_URL=
GENERATED_AUDIO_BLOB_READ_WRITE_TOKEN=

# Optional upload limits.
AUDIO_UPLOAD_MAX_CHUNK_BYTES=1048576
AUDIO_UPLOAD_MAX_SESSION_BYTES=16777216
AUDIO_UPLOAD_MAX_CHUNKS=1000
AUDIO_UPLOAD_SESSION_TTL_SECONDS=900
