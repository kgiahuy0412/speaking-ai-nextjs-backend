{
  "name": "ai-speaking-device-mvp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:cloudflare": "node --import tsx --test src/lib/ai/cloudflareWorkersAi.test.ts",
    "test:cloudflare-text": "node --import tsx --test src/lib/ai/cloudflareText.test.ts",
    "benchmark:cloudflare-text": "node --env-file=.env.local --import tsx scripts/benchmark-cloudflare-text.ts",
    "test:translation": "node --import tsx --test --test-concurrency=1 src/lib/ai/faithfulTranslation.test.ts src/lib/ai/corpusRules.test.ts src/lib/ai/phraseSupplementRules.test.ts src/lib/ai/textCache.test.ts src/lib/ai/singleFlight.test.ts src/lib/ai/batchPrefetch.test.ts",
    "test:transcript": "node --import tsx --test src/lib/audio/trimRecordedAudio.test.ts src/lib/ai/transcriptRepair.test.ts src/lib/ai/transcriptCorpusRepair.test.ts src/lib/ai/regionalVocabularyNormalizer.test.ts src/lib/ai/transcriptQuality.test.ts",
    "test:storage": "node --import tsx --test --test-concurrency=1 src/lib/client/audioSessionUploader.test.ts src/lib/storage/audioSessionSecurity.test.ts src/lib/storage/audioSessionR2.test.ts src/lib/storage/audioSessions.test.ts src/lib/storage/audio.test.ts src/lib/storage/config.test.ts src/lib/db/schema.test.ts",
    "test:ai-provider": "node --import tsx --test src/lib/ai/aiProvider.test.ts",
    "test:cloudflare-only": "node --import tsx --test src/lib/ai/cloudflareOnly.test.ts",
    "test:tts-cache": "node --import tsx --test --test-concurrency=1 src/lib/ai/tts.test.ts",
    "test:admin-auth": "node --import tsx --test src/lib/adminAuthCore.test.ts",
    "test:app-version": "node --import tsx --test src/lib/appVersionPolicy.test.ts",
    "test:proxy": "node --import tsx --test src/proxy.test.ts",
    "storage:check": "node --env-file=.env.local --import tsx scripts/check-storage.ts",
    "storage:migrate:dry-run": "node --env-file=.env.local --import tsx scripts/migrate-local-to-managed.ts --dry-run",
    "storage:migrate": "node --env-file=.env.local --import tsx scripts/migrate-local-to-managed.ts",
    "storage:rollback": "node --env-file=.env.local --import tsx scripts/rollback-managed-to-local.ts",
    "storage:rollback:apply": "node --env-file=.env.local --import tsx scripts/rollback-managed-to-local.ts --apply"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1096.0",
    "@neondatabase/serverless": "^1.0.2",
    "@vercel/blob": "^2.6.1",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  },
  "overrides": {
    "sharp": "0.35.3",
    "next": {
      "postcss": "8.5.20"
    }
  }
}
